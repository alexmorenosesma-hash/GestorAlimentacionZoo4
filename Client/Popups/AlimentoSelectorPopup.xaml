<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:Client.Pagemodel.Popups"
    xmlns:models="clr-namespace:Domain.Entities;assembly=Domain"
    x:Class="Client.Popups.AlimentoSelectorPopup"
    x:DataType="vm:AlimentoSelectorPopupPagemodel"
    Background="#E8E3D3">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Label Text="Seleccionar alimentos" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" />
            <CollectionView ItemsSource="{Binding Alimentos}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:AlimentoItem">
                        <HorizontalStackLayout Padding="5" Spacing="15" VerticalOptions="Center">
                            <CheckBox IsChecked="{Binding Seleccionado}" Color="#14453D"/>
                            <Label Text="{Binding Nombre}" VerticalOptions="Center" />
                            <Entry Text="{Binding Cantidad, Mode=TwoWay}" WidthRequest="60" Keyboard="Numeric" HorizontalTextAlignment="Center" IsEnabled="{Binding Seleccionado}" Margin="5,0,0,0" />
                            <Label Text="{Binding Unidad}" VerticalOptions="Center" Margin="3,0,0,0" />
                        </HorizontalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Button Text="Guardar" Command="{Binding ConfirmCommand}" BackgroundColor="#D9E2D0" TextColor="#14453D" BorderColor="#14453D" BorderWidth="3" FontAttributes="Bold"/>
            <Button Text="Cancelar" Command="{Binding CancelCommand}" BackgroundColor="#D9E2D0" TextColor="#14453D" BorderColor="#14453D" BorderWidth="3" FontAttributes="Bold"/>
        </VerticalStackLayout>
    </ScrollView>
</toolkit:Popup>
