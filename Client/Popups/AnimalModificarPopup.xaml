<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup  xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit" xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Client.Pagemodel.Popups"
             xmlns:models="clr-namespace:Domain.Entities;assembly=Domain"
             x:Class="Client.Popups.AnimalModificarPopup"
             x:DataType="vm:AnimalModificarPopupPagemodel"
             x:TypeArguments="models:Animal" 
             Background="#E8E3D3">
    <ScrollView>
        <VerticalStackLayout>
            <StackLayout>
                <Label Text="Escribe el nombre del animal" FontAttributes="Bold"/>
                <Border Stroke="#14453D" Margin="0,0,0,5" StrokeThickness="3">
                    <Entry Text="{Binding Model.nombre, Mode=TwoWay}"/>
                </Border>
                <Label Text="Escribe la edad del animal" FontAttributes="Bold"/>
                <Border Stroke="#14453D" Margin="0,0,0,5" StrokeThickness="3">
                    <Entry Text="{Binding Model.edad, Mode=TwoWay}"/>
                </Border>
                <Label Text="Escribe el peso del animal" FontAttributes="Bold"/>
                <Border Stroke="#14453D" Margin="0,0,0,5" StrokeThickness="3">
                    <Entry Text="{Binding Model.peso, Mode=TwoWay}"/>
                </Border>
                <Label Text="Selecciona la especie del animal" FontAttributes="Bold"/>
                <Border Stroke="#14453D" Margin="0,0,0,5" StrokeThickness="3">
                    <Picker ItemsSource="{Binding NombresEspecies}" SelectedItem="{Binding EspecieSeleccionada, Mode=TwoWay}"/>
                </Border>
                <Label Text="Selecciona la dieta del animal" FontAttributes="Bold"/>
                <Border Stroke="#14453D" Margin="0,0,0,5" StrokeThickness="3">
                    <Picker ItemsSource="{Binding NombresDietas}" SelectedItem="{Binding DietaSeleccionada, Mode=TwoWay}"/>
                </Border>
                <Label Text="Selecciona el cuidador del animal" FontAttributes="Bold"/>
                <Border Stroke="#14453D" Margin="0,0,0,5" StrokeThickness="3">
                    <Picker ItemsSource="{Binding NombresCuidadores}" SelectedItem="{Binding CuidadorSeleccionado, Mode=TwoWay}"/>
                </Border>
            </StackLayout>
            <Button Text="Modificar horarios" Command="{Binding SeleccionarHorariosCommand}" BackgroundColor="#D9E2D0" TextColor="#14453D" BorderColor="#14453D" BorderWidth="3" FontAttributes="Bold" Margin="0,10"/>
            <Button Text="Modificar enfermedades" Command="{Binding SeleccionarEnfermedadesCommand}" BackgroundColor="#D9E2D0" TextColor="#14453D" BorderColor="#14453D" BorderWidth="3" FontAttributes="Bold" Margin="0,10"/>
            <Button Text="Guardar" Command="{Binding SaveCommand}" BackgroundColor="#D9E2D0" TextColor="#14453D" BorderColor="#14453D" BorderWidth="3" FontAttributes="Bold" Margin="0,0,0,5"/>
            <Button Text="Cancelar" Command="{Binding CancelCommand}" BackgroundColor="#D9E2D0" TextColor="#14453D" BorderColor="#14453D" BorderWidth="3" FontAttributes="Bold"/>
        </VerticalStackLayout>
    </ScrollView>
</toolkit:Popup>